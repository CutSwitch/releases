#!/usr/bin/env python3
"""Dispatch release commands to the configured private app checkout on this host."""
from __future__ import annotations

import argparse
import json
import os
from pathlib import Path
import stat
import subprocess
import sys


DEFAULT_CONFIG = Path.home() / "Library/Application Support/CutSwitchRelease/config.json"
EXPECTED_ORIGINS = {
    "https://github.com/cutswitch/cutswitch-app",
    "git@github.com:cutswitch/cutswitch-app",
    "ssh://git@github.com/cutswitch/cutswitch-app",
}


class DispatchError(Exception):
    pass


def checked_config(path: Path) -> tuple[Path, Path]:
    try:
        metadata = path.lstat()
    except OSError:
        raise DispatchError("Release host is not configured. Follow README.md on the release Mac.")
    if not stat.S_ISREG(metadata.st_mode) or metadata.st_uid != os.getuid() or metadata.st_mode & 0o077:
        raise DispatchError("Release config must be a regular, owner-only file (chmod 600).")
    if metadata.st_size > 64 * 1024:
        raise DispatchError("Release config is too large.")
    try:
        with path.open(encoding="utf-8") as handle:
            data = json.load(handle)
        value = data.get("app_repo") if isinstance(data, dict) else None
        if not isinstance(value, str) or not value or any(c in value for c in "\x00\r\n"):
            raise ValueError()
        root = Path(value).expanduser()
        if not root.is_absolute():
            raise ValueError()
        root = root.resolve(strict=True)
        if not root.is_dir():
            raise ValueError()
    except (OSError, ValueError, TypeError):
        raise DispatchError("Release config requires an existing absolute app_repo directory.")
    return path.resolve(strict=True), root


def git_read(root: Path, *arguments: str) -> str:
    try:
        result = subprocess.run(
            ["git", "-C", str(root), *arguments],
            check=True, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL,
            text=True, timeout=15,
        )
    except (OSError, subprocess.SubprocessError):
        raise DispatchError("Cannot verify the configured app checkout with Git.")
    return result.stdout.strip()


def workflow_command(config: Path, arguments: list[str]) -> tuple[list[str], Path]:
    config, root = checked_config(config)
    if Path(git_read(root, "rev-parse", "--show-toplevel")).resolve() != root:
        raise DispatchError("app_repo must be the root of the private app checkout.")
    origin = git_read(root, "remote", "get-url", "origin").rstrip("/")
    if origin.lower().endswith(".git"):
        origin = origin[:-4]
    if origin.lower() not in EXPECTED_ORIGINS:
        raise DispatchError("Configured app origin must be CutSwitch/cutswitch-app on GitHub.")
    # The explicit QA namespace uses the same trusted checkout/configuration.
    # Neither private driver has a remote publication executor.
    is_qa = bool(arguments) and arguments[0] == "qa"
    if is_qa:
        arguments = arguments[1:] or ["--help"]
    script = root / "scripts/cutswitch" / ("release_qa.py" if is_qa else "release_mac.py")
    try:
        metadata = script.lstat()
    except OSError:
        raise DispatchError("This app checkout has no release workflow. Sync the verified tooling first.")
    if not stat.S_ISREG(metadata.st_mode) or metadata.st_mode & 0o022:
        raise DispatchError("Release workflow must be a regular file without group/world write access.")
    if script.resolve() != script:
        raise DispatchError("Release workflow path escaped the configured checkout.")
    return [sys.executable, str(script), "--config", str(config), *arguments], root


def main(arguments: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(
        description="Run the private CutSwitch workflow on the configured release host.",
        epilog="Commands and release policy live in the private app repository. This launcher never publishes by itself.",
        add_help=False,
    )
    parser.add_argument("--config", type=Path, default=DEFAULT_CONFIG)
    options, remaining = parser.parse_known_args(arguments)
    if not remaining:
        parser.print_help()
        print("\nAfter host setup: ./cutswitch-release doctor")
        return 0
    try:
        command, root = workflow_command(options.config.expanduser(), remaining)
        os.chdir(root)
        os.execv(sys.executable, command)
    except DispatchError as error:
        print(f"STOP: {error}", file=sys.stderr)
        return 2
    except OSError:
        print("STOP: Could not start the configured release workflow.", file=sys.stderr)
        return 2
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
